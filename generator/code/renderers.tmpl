{{$count := len .Attributes}}
// --- Renderers ---

/// render creates a Lustre Element for a {{.Name}}
///
pub fn render(
{{- if gt $count 0 }}
 model: {{.Name}},
{{- else -}}
 _: {{.Name}},
{{- end }}
 attributes: List(Attribute(msg)),
{{- if .HasChildren -}}
 children: List(Element(msg)),
{{- end -}}
) -> Element(msg) {
 element.element(
   "{{.Tag}}",
{{- if gt $count 0 }}
   list.flatten([
     [
{{- range .Attributes}}
       {{.}},
{{- end}}
     ],
     attributes,
   ])
     |> list.filter(fn(a) { a != attribute.none() }),
{{- else -}}
   attributes,
{{- end -}}
{{- if .HasChildren }}
   children,
{{- else }}
   [],
{{- end }}
 )
}

